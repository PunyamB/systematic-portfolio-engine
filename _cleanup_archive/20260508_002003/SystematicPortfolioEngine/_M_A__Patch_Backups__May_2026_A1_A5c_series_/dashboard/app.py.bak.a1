REGIME_COLORS = {
    "bull":     "rgba(0,196,180,0.13)",
    "recovery": "rgba(74,144,217,0.10)",
    "bear":     "rgba(212,160,23,0.13)",
    "crisis":   "rgba(224,82,82,0.14)",
}
REGIME_HEX = {
    "bull":     "#00C4B4",
    "recovery": "#4A90D9",
    "bear":     "#D4A017",
    "crisis":   "#E05252",
}

# ── SIDEBAR NAV ───────────────────────────────────────────────────────────────
st.sidebar.markdown("## ▲ QuantForge")
st.sidebar.markdown("**Operational Dashboard**")
